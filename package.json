{
  "name": "varscout",
  "displayName": "VarScout",
  "description": "Autocomplete CSS custom properties from your project's CSS token files, making design tokens easier to discover and use across your codebase.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:css",
    "onLanguage:scss",
    "onLanguage:less",
    "onLanguage:vue",
    "onLanguage:svelte",
    "onLanguage:astro",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "CSS Tokens",
      "properties": {
        "cssTokens.files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/tokens.css"
          ],
          "markdownDescription": "Paths or globs of the CSS token files: relative to each workspace folder, absolute, or a file inside an installed package such as `@acme/tokens/dist/tokens.css` (looked up in the nearest `node_modules`). Globs skip `node_modules` unless the entry names it. VS Code doesn't watch `node_modules`, so after updating a package run **VarScout: Reload Tokens**."
        },
        "cssTokens.rootFontSize": {
          "type": "number",
          "default": 16,
          "minimum": 1,
          "markdownDescription": "Size of `1rem` in px, used to show px equivalents of `rem` values (e.g. `1.5rem (24px)`). Set it if your root font size isn't 16px."
        }
      }
    },
    "commands": [
      {
        "command": "varscout.showTokens",
        "title": "VarScout: Show Parsed Tokens"
      },
      {
        "command": "varscout.reloadTokens",
        "title": "VarScout: Reload Tokens"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "dev": "pnpm run compile && code --extensionDevelopmentPath=\"$PWD\" test-fixtures/ws"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "postcss": "^8.5.30"
  }
}
