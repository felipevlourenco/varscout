{
  "name": "varscout",
  "displayName": "VarScout",
  "description": "Autocomplete CSS custom properties from your project's CSS token files, making design tokens easier to discover and use across your codebase.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:css"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "CSS Tokens",
      "properties": {
        "cssTokens.files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/tokens.css"
          ],
          "markdownDescription": "Paths or globs of the CSS token files (relative to each workspace folder, or absolute). `node_modules` is excluded from globs."
        }
      }
    },
    "commands": [
      {
        "command": "varscout.showTokens",
        "title": "VarScout: Show Parsed Tokens"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "dev": "pnpm run compile && code --extensionDevelopmentPath=\"$PWD\" test-fixtures/ws"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "postcss": "^8.5.30"
  }
}
